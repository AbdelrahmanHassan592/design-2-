<?xml version="1.0"?>
<robot name="lab2_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="simulation" default="false"/>
  <xacro:arg name="controllers" default=""/>

  <!-- Each box has its center halfway along the link. -->
  <xacro:macro name="box_link" params="name x y z cx cz mass color">
    <link name="${name}">
      <visual>
        <origin xyz="${cx} 0 ${cz}"/>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
        <material name="${name}_color"><color rgba="${color}"/></material>
      </visual>
      <collision>
        <origin xyz="${cx} 0 ${cz}"/>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${cx} 0 ${cz}"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
                 iyy="${mass*(x*x+z*z)/12}" iyz="0"
                 izz="${mass*(x*x+y*y)/12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="hinge" params="name parent child xyz axis rpy:='0 0 0'">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:box_link name="base_link" x="0.10" y="0.10" z="0.08" cx="0" cz="0.04" mass="0.45" color="0.18 0.21 0.25 1"/>
  <xacro:box_link name="L1" x="0.035" y="0.035" z="0.12" cx="0" cz="0.06" mass="0.10" color="0.13 0.45 0.80 1"/>
  <xacro:box_link name="L2" x="0.15" y="0.03" z="0.03" cx="0.075" cz="0" mass="0.09" color="0.20 0.63 0.85 1"/>
  <xacro:box_link name="L3" x="0.09" y="0.025" z="0.025" cx="0.045" cz="0" mass="0.06" color="0.13 0.45 0.80 1"/>
  <xacro:box_link name="wrist_link" x="0.02" y="0.025" z="0.025" cx="0.01" cz="0" mass="0.025" color="0.18 0.21 0.25 1"/>
  <xacro:box_link name="end_effector" x="0.04" y="0.024" z="0.024" cx="0.02" cz="0" mass="0.035" color="0.94 0.49 0.14 1"/>

  <xacro:hinge name="joint1" parent="base_link" child="L1" xyz="0 0 0.08" axis="0 0 1"/>
  <xacro:hinge name="joint2" parent="L1" child="L2" xyz="0 0 0.12" axis="0 1 0" rpy="0 ${-pi/2} 0"/>
  <xacro:hinge name="joint3" parent="L2" child="L3" xyz="0.15 0 0" axis="0 1 0" rpy="0 ${pi/2} 0"/>
  <xacro:hinge name="joint4" parent="L3" child="wrist_link" xyz="0.09 0 0" axis="0 1 0"/>
  <joint name="tool_mount" type="fixed">
    <parent link="wrist_link"/>
    <child link="end_effector"/>
    <origin xyz="0.02 0 0"/>
  </joint>

  <xacro:if value="$(arg simulation)">
    <!-- Fix the base to the Gazebo world. -->
    <link name="world">
      <visual><geometry><box size="0.001 0.001 0.001"/></geometry></visual>
      <collision><geometry><box size="0.001 0.001 0.001"/></geometry></collision>
      <inertial><mass value="0.001"/><inertia ixx="1e-10" ixy="0" ixz="0" iyy="1e-10" iyz="0" izz="1e-10"/></inertial>
    </link>
    <joint name="base_mount" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
    </joint>
    <gazebo reference="base_mount"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

    <xacro:macro name="control_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <xacro:control_joint name="joint1"/>
      <xacro:control_joint name="joint2"/>
      <xacro:control_joint name="joint3"/>
      <xacro:control_joint name="joint4"/>
    </ros2_control>
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
